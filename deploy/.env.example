# ============================================================
# 掌柜智库 (Shopkeeper Think Tank) 环境变量配置模板（阶段5）
# 复制本文件为项目根目录 .env 并填入真实值：
#   Windows:  copy deploy\.env.example .env
#   Linux:    cp deploy/.env.example .env
# 代码中通过 shopkeeper_common.config 的 env_str / env_bool 读取
# ============================================================

# ---------------------- 应用基础配置（五服务） ----------------------
GATEWAY_APP_NAME=shopkeeper-gateway
GATEWAY_APP_PORT=8080
AUTH_APP_NAME=shopkeeper-auth
AUTH_APP_PORT=8083
USER_APP_NAME=shopkeeper-user
USER_APP_PORT=8084
IMPORT_APP_NAME=shopkeeper-knowledge
IMPORT_APP_PORT=8081
QUERY_APP_NAME=shopkeeper-query
QUERY_APP_PORT=8082

# ---------------------- 网关（统一入口） ----------------------
# strict=必须携带 token；optional=未携带放行 guest（默认）
GATEWAY_AUTH_MODE=optional
# 限流：每分钟每 IP 请求数上限，0=关闭
GATEWAY_RATE_LIMIT=0
# 后端统一 host（本地直接运行用 127.0.0.1；Docker 内由 compose 覆盖为容器服务名）
GATEWAY_BACKEND_HOST=127.0.0.1
# 各后端独立 host 覆盖（Docker 内由 compose 注入，可留空）
GATEWAY_AUTH_HOST=
GATEWAY_USER_HOST=
GATEWAY_IMPORT_HOST=
GATEWAY_QUERY_HOST=
# 前端静态产物目录（Docker 内由 compose 覆盖为 /app/frontend/dist）
GATEWAY_DIST_DIR=

# ---------------------- 基础设施（Docker 编排） ----------------------
MONGO_USER=root
MONGO_PASSWORD=shopkeeper123
MINIO_ACCESS_KEY=shopkeeper
MINIO_SECRET_KEY=shopkeeper123
# 本地模型根目录（挂载进 knowledge/query 容器）
BGE_MODELS_DIR=D:/ai_models
# 容器内模型子目录（按实际目录结构调整）
CONTAINER_BGE_M3_PATH=/models/BAAI/bge-m3
CONTAINER_BGE_RERANKER_LARGE=/models/BAAI/bge-reranker-v2-m3

# ---------------------- 大模型 LLM（通义千问 DashScope） ----------------------
# DashScope 兼容 OpenAI 协议，OPENAI_API_KEY 即百炼 API Key
OPENAI_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=qwen-plus
VL_MODEL=qwen-vl-max
# 离线调试用 mock LLM（True 时问答不调远程）
LLM_MOCK=False

# ---------------------- 向量模型 Embedding（BGE-M3 本地） ----------------------
# 本地直接运行 BGE_M3_PATH 填宿主机路径；Docker 内由 compose 覆盖为容器路径
BGE_M3=local
BGE_M3_PATH=D:\ai_models\modelscope_cache\models\BAAI\bge-m3
BGE_DEVICE=cpu
BGE_FP16=False
EMBEDDING_DIM=1024

# ---------------------- 重排序模型 Reranker（BGE-Reranker 本地） ----------------------
BGE_RERANKER_LARGE=D:\ai_models\modelscope_cache\models\BAAI\bge-reranker-v2-m3
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=False

# ---------------------- Milvus 向量库 ----------------------
# 本地直接运行用 127.0.0.1；Docker 内由 compose 覆盖为 http://milvus:19530
MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=kb_chunks
ENTITY_NAME_COLLECTION=kb_entity_names
ITEM_NAME_COLLECTION=kb_item_names

# ---------------------- MongoDB 持久化 ----------------------
# 所有服务共享同一 DB（跨服务 token 校验依赖共享 auth_tokens 集合），勿改动
# 本地直接运行：基础设施由 compose 拉起，mongo 已启用认证（见 MONGO_USER/MONGO_PASSWORD），
#   故 URL 须带账号密码；Docker 内由 compose 覆盖为带账号的 mongo 地址
# 注意：若本地 mongo 未启用认证，可改回 mongodb://127.0.0.1:27017
MONGO_URL=mongodb://root:shopkeeper123@127.0.0.1:27017
MONGO_DB_NAME=enterprise_rag

# ---------------------- MinIO 对象存储 ----------------------
# 本地直接运行用 localhost；Docker 内由 compose 覆盖为 object-storage:9000
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=shopkeeper
MINIO_SECURE=False

# ---------------------- MinerU PDF 解析服务 ----------------------
MINERU_API_URL=your_mineru_api_url

# ---------------------- 联网搜索 MCP（DashScope WebSearch） ----------------------
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp

# ---------------------- 日志配置 ----------------------
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=ERROR
LOG_FILE_RETENTION=7 days

# ---------------------- 引导管理员（注册时命中则角色为 admin，逗号分隔） ----------------------
AUTH_BOOTSTRAP_ADMIN=admin
