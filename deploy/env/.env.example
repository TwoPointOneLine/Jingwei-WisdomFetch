# ============================================================
# 精卫 (Jingwei WisdomFetch) 环境变量模板（唯一）
# ------------------------------------------------------------
# 使用方式：复制本文件为【仓库根】.env，然后填入真实值。
#   Windows:  copy deploy\env\.env.example .env
#   Linux:    cp deploy/env/.env.example .env
#
# ⚠️ 位置必须是【仓库根】：
#   - 本地运行：jingwei_common.config 会读取仓库根 .env
#   - 容器部署：deploy/compose.yml 通过 env_file: [../.env] 引用
#     （相对 deploy/ 目录，即仓库根 .env）
#   放到 deploy/.env 或 backend/.env 都不会生效。
#
# 代码中通过 jingwei_common.config 的 env_str / env_bool / env_int 读取。
# 真实环境变量（如 Docker environment）优先级高于本文件。
#
# 历史说明：此前模板分散在 deploy/.env.example 与
# backend/services/*/.env.example 共 6 处，易漂移且缺失变量。
# 现已合并为本文件，后者全部删除。
# ============================================================

# ---------------------- 应用基础配置（五服务） ----------------------
# 服务监听地址：0.0.0.0 允许容器外访问；本地调试可用 127.0.0.1
APP_HOST=0.0.0.0
# 允许的跨域来源，逗号分隔；* 表示全部放行（生产环境请显式指定）
CORS_ORIGINS=*
GATEWAY_APP_NAME=jingwei-gateway
GATEWAY_APP_PORT=8080
AUTH_APP_NAME=jingwei-auth
AUTH_APP_PORT=8083
USER_APP_NAME=jingwei-user
USER_APP_PORT=8084
IMPORT_APP_NAME=jingwei-knowledge
IMPORT_APP_PORT=8081
QUERY_APP_NAME=jingwei-query
QUERY_APP_PORT=8082

# ---------------------- 网关（统一入口） ----------------------
# strict=必须携带 token；optional=未携带放行 guest（默认）
GATEWAY_AUTH_MODE=optional
# 限流：每分钟每 IP 请求数上限，0=关闭
GATEWAY_RATE_LIMIT=0
# 后端统一 host（本地直接运行用 127.0.0.1；Docker 内由 compose 覆盖为容器服务名）
GATEWAY_BACKEND_HOST=127.0.0.1
# 各后端独立 host 覆盖（Docker 内由 compose 注入，可留空）
GATEWAY_AUTH_HOST=
GATEWAY_USER_HOST=
GATEWAY_IMPORT_HOST=
GATEWAY_QUERY_HOST=
# 前端静态产物目录（Docker 内由 compose 覆盖为 /app/frontend/dist）
GATEWAY_DIST_DIR=

# ---------------------- 基础设施（Docker 编排） ----------------------
# ⚠️ 下列为【本地开发默认值】，部署到任何非本机环境前必须修改
MONGO_USER=root
# CHANGE_ME
MONGO_PASSWORD=shopkeeper123
# CHANGE_ME
MINIO_ACCESS_KEY=shopkeeper
# CHANGE_ME
MINIO_SECRET_KEY=shopkeeper123
# 本地模型根目录（挂载进 knowledge/query 容器）
BGE_MODELS_DIR=/path/to/ai_models
# 容器内模型子目录（按实际目录结构调整）
CONTAINER_BGE_M3_PATH=/models/BAAI/bge-m3
CONTAINER_BGE_RERANKER_LARGE=/models/BAAI/bge-reranker-v2-m3

# ---------------------- 大模型 LLM ----------------------
# provider 选择：dashscope（在线通义千问）| local（本地 Ollama/LM Studio/vLLM）
LLM_PROVIDER=dashscope

# ---- DashScope（在线，LLM_PROVIDER=dashscope 时生效）----
# DashScope 兼容 OpenAI 协议，OPENAI_API_KEY 即百炼 API Key
# ⚠️ 必填：留占位值会导致 query_rewrite / HyDE 失效
OPENAI_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://<your-dashscope-endpoint>/api/v1
LLM_DEFAULT_MODEL=qwen-plus
VL_MODEL=qwen-vl-max

# ---- 本地模型（LLM_PROVIDER=local 时生效）----
# 本地 OpenAI 兼容服务地址
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# 本地对话模型（需已 pull 到本地服务）
LOCAL_LLM_MODEL=qwen3:8b
# 本地多模态 / 备用模型
LOCAL_VL_MODEL=qwen2.5-coder:14b

# 离线调试用 mock LLM（True 时问答不调远程）
LLM_MOCK=False
# 联网检索总开关：默认关闭，保证回答仅基于已导入的内部资料（FR-QA-06）。
# 仅显式开启时才将外网结果混入重排与生成，且结果带 external 标记可溯源。
WEB_SEARCH_ENABLED=False

# ---------------------- 向量模型 Embedding（BGE-M3 本地） ----------------------
# BGE_M3 后端选择（默认 ollama，即本地 Ollama 的 /api/embed，GPU 加速、无需 CUDA torch）：
#   - ollama：经本地 Ollama 服务向量化（bge-m3:latest），轻量、免 CUDA 编译的 torch
#   - local ：FlagEmbedding 直接加载权重（稠密+稀疏混合），但需 CPU 推理或自行配置 CUDA，
#             否则 model.to(cuda) 报 “Torch not compiled with CUDA enabled”
# ⚠️ Windows 路径请用正斜杠或双反斜杠；单个反斜杠会被 huggingface_hub 拒绝
BGE_M3=ollama
BGE_M3_PATH=/path/to/ai_models/modelscope_cache/models/BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=False
EMBEDDING_DIM=1024
# BGE_M3=ollama 时通过 Ollama 服务调用向量化
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_BGE_M3_MODEL=bge-m3:latest

# ---------------------- 重排序模型 Reranker（BGE-Reranker 本地） ----------------------
# ⚠️ 即使上方 BGE_M3=ollama，Reranker 仍必须走 local（FlagEmbedding 直接加载权重）：
#   本地 Ollama 二进制通常未注册 /api/rerank 路由，无法提供重排服务；venv 内 torch 多为
#   CPU 版，故 device 必须=cpu。HF 权重就位于下方 BGE_RERANKER_LARGE 路径。
BGE_RERANKER_LARGE=/path/to/ai_models/modelscope_cache/models/BAAI/bge-reranker-v2-m3
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=False

# ---------------------- RAG 检索/生成调优参数（rag_config，G-05/G-10） ----------------------
# 单路召回返回条数（向量路 / HyDE 路各自取此 top_k 做 RRF 合并前候选）
RETRIEVAL_TOP_K=10
# 是否启用 HyDE（假设性文档）召回
HYDE_ENABLED=True
# RRF 融合常数 k，越大则排名靠前的影响越小
RRF_K=60
# 是否启用 BGE-Reranker 精排（关闭则退化为 RRF 粗排截断）
RERANK_ENABLED=True
# 精排后保留的上下文条数（送入 LLM 的原文块数量）
RERANK_TOP_K=5
# 精排分数下限（0~1，归一化）。低于此值的候选视为不相关，直接触发低分拒答（G-05）。
# 设为 0 可关闭过滤。
RERANK_SCORE_THRESHOLD=0.35
# 注入作答 prompt 的历史轮数（1 轮 = 1 条 user + 1 条 assistant）
HISTORY_TURNS=4
# query rewrite 阶段读取的历史条数
REWRITE_HISTORY_LIMIT=10
# 引用来源中原文片段的最大字符数（G-08）
CITATION_SNIPPET_CHARS=200
# 外部兜底大模型：知识库无可用上下文时，调用通用大模型直接作答（不基于检索资料）。
# 默认关闭——开启后回答不再受知识库约束，可能编造，仅作最后兜底；仍经合规护栏处理，
# 并强制标注「未基于知识库、未经内部资料校验」来源提示。
EXTERNAL_FALLBACK_ENABLED=False

# ---------------------- Milvus 向量库 ----------------------
# 本地直接运行用 127.0.0.1；Docker 内由 compose 覆盖为 http://milvus:19530
MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=kb_chunks
ENTITY_NAME_COLLECTION=kb_entity_names
ITEM_NAME_COLLECTION=kb_item_names

# ---------------------- MongoDB 持久化 ----------------------
# 所有服务共享同一 DB（跨服务 token 校验依赖共享 auth_tokens 集合），勿改动
# 本地直接运行：基础设施由 compose 拉起，mongo 已启用认证（见 MONGO_USER/MONGO_PASSWORD），
#   故 URL 须带账号密码；Docker 内由 compose 覆盖为带账号的 mongo 地址
# 注意：若本地 mongo 未启用认证，可改回 mongodb://127.0.0.1:27017
MONGO_URL=mongodb://root:shopkeeper123@127.0.0.1:27017
MONGO_DB_NAME=enterprise_rag

# ---------------------- MinIO 对象存储 ----------------------
# 本地直接运行用 localhost；Docker 内由 compose 覆盖为 object-storage:9000
MINIO_ENDPOINT=localhost:9000
# ⚠️ 与上方「基础设施」段的 MINIO_ACCESS_KEY / MINIO_SECRET_KEY 是同一组变量，
#    此处不再重复定义（此前重复导致后者覆盖前者，实际生效的是占位值）。
# 默认桶名与代码常量一致（jingwei）。若历史资料已存入其它桶（如早期 shopkeeper），
# 须在此改为对应桶名，否则旧数据无法读取。
MINIO_BUCKET=jingwei
MINIO_SECURE=False

# ---------------------- MinerU PDF 解析服务 ----------------------
MINERU_API_URL=your_mineru_api_url

# ---------------------- 联网搜索 MCP（DashScope WebSearch） ----------------------
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp

# ---------------------- 日志配置 ----------------------
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=ERROR
LOG_FILE_RETENTION=7 days

# ---------------------- 引导管理员（注册时命中则角色为 admin，逗号分隔） ----------------------
AUTH_BOOTSTRAP_ADMIN=admin

# ---------------------- 可选：显式指定仓库根 ----------------------
# 公共模块作为独立 wheel 安装到 site-packages 时，目录上溯定位会失效，
# 此时用本变量显式指定【仓库根】（含 .env / frontend / deploy 的 monorepo 根）。
# 正常从仓库运行无需设置。
# JINGWEI_ROOT=/path/to/Jingwei-WisdomFetch
