# ============================================================
# 精卫 (Jingwei WisdomFetch) 生产环境变量模板
# ------------------------------------------------------------
# 与 .env.example 字段完全一致，仅在本文件顶部/相关处标注【生产必改】。
# 使用方式：复制本文件为【仓库根】.env.prod，填入真实强凭据后，
#   用生产编排启动： docker compose -f deploy/compose.yml -f deploy/compose.prod.yml up -d
#
# 说明：生产编排通过 env_file: [../.env.prod] 引用本文件；若改用 .env，
#   请在 compose.prod.yml 的 env_file 中改回 ../.env。
# ============================================================

# ---------------------- 应用基础配置（五服务） ----------------------
APP_HOST=0.0.0.0
# 【生产必改】显式指定可信前端域名，切勿保留 *
CORS_ORIGINS=https://your-domain.example.com
GATEWAY_APP_NAME=jingwei-gateway
GATEWAY_APP_PORT=8080
AUTH_APP_NAME=jingwei-auth
AUTH_APP_PORT=8083
USER_APP_NAME=jingwei-user
USER_APP_PORT=8084
IMPORT_APP_NAME=jingwei-knowledge
IMPORT_APP_PORT=8081
QUERY_APP_NAME=jingwei-query
QUERY_APP_PORT=8082

# ---------------------- 网关（统一入口） ----------------------
# 【生产必改】设为 strict，未携带 token 一律拒绝
GATEWAY_AUTH_MODE=strict
# 【生产建议】开启限流（例如 600 = 每分钟每 IP 600 请求）
GATEWAY_RATE_LIMIT=600
GATEWAY_BACKEND_HOST=127.0.0.1
GATEWAY_AUTH_HOST=
GATEWAY_USER_HOST=
GATEWAY_IMPORT_HOST=
GATEWAY_QUERY_HOST=
GATEWAY_DIST_DIR=

# ---------------------- 基础设施（Docker 编排） ----------------------
# 【生产必改】以下三项必须替换为强随机凭据，禁止使用示例值
MONGO_USER=root
# CHANGE_ME —— 生成示例：openssl rand -base64 24
MONGO_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# CHANGE_ME
MINIO_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
# CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME_STRONG_SECRET
# 本地模型根目录（挂载进 knowledge/query 容器）
BGE_MODELS_DIR=/opt/ai_models
CONTAINER_BGE_M3_PATH=/models/BAAI/bge-m3
CONTAINER_BGE_RERANKER_LARGE=/models/BAAI/bge-reranker-v2-m3

# ---------------------- 大模型 LLM ----------------------
LLM_PROVIDER=dashscope
# 【生产必改】填入真实百炼 API Key（占位值会导致 query_rewrite/HyDE 失效）
OPENAI_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=qwen-plus
VL_MODEL=qwen-vl-max

# ---- 本地模型（LLM_PROVIDER=local 时生效）----
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen3:8b
LOCAL_VL_MODEL=qwen2.5-coder:14b

LLM_MOCK=False
# 【生产建议】默认关闭外网检索，保证回答仅基于内部资料（FR-QA-06）
WEB_SEARCH_ENABLED=False

# ---------------------- 向量模型 Embedding（BGE-M3 本地） ----------------------
BGE_M3=local
BGE_M3_PATH=/opt/ai_models/modelscope_cache/models/BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=False
EMBEDDING_DIM=1024
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_BGE_M3_MODEL=bge-m3:latest

# ---------------------- 重排序模型 Reranker（BGE-Reranker 本地） ----------------------
BGE_RERANKER_LARGE=/opt/ai_models/modelscope_cache/models/BAAI/bge-reranker-v2-m3
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=False

# ---------------------- Milvus 向量库 ----------------------
MILVUS_URL=http://milvus:19530
CHUNKS_COLLECTION=kb_chunks
ENTITY_NAME_COLLECTION=kb_entity_names
ITEM_NAME_COLLECTION=kb_item_names

# ---------------------- MongoDB 持久化 ----------------------
MONGO_URL=mongodb://root:CHANGE_ME_STRONG_PASSWORD@mongo:27017
MONGO_DB_NAME=enterprise_rag

# ---------------------- MinIO 对象存储 ----------------------
MINIO_ENDPOINT=object-storage:9000
MINIO_BUCKET=jingwei
MINIO_SECURE=False

# ---------------------- MinerU PDF 解析服务 ----------------------
# 【生产必改】填入真实 MinerU API 地址
MINERU_API_URL=your_mineru_api_url

# ---------------------- 联网搜索 MCP（DashScope WebSearch） ----------------------
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp

# ---------------------- 日志配置 ----------------------
LOG_CONSOLE_ENABLE=False
LOG_CONSOLE_LEVEL=WARNING
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=30 days

# ---------------------- 引导管理员（注册时命中则角色为 admin，逗号分隔） ----------------------
AUTH_BOOTSTRAP_ADMIN=admin

# ---------------------- 可选：显式指定仓库根 ----------------------
# JINGWEI_ROOT=/path/to/Jingwei-WisdomFetch
