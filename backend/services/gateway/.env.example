# ── 应用 ─────────────────────────────────────────────
APP_ENV=dev
APP_HOST=0.0.0.0
GATEWAY_APP_NAME=jingwei-gateway
GATEWAY_APP_PORT=8080
CORS_ORIGINS=*

# ── 鉴权前置 ─────────────────────────────────────────
# strict=必须 token / optional=带 token 则校验（默认）
GATEWAY_AUTH_MODE=optional
# 每分钟每 IP 最大请求数（0=关闭）
GATEWAY_RATE_LIMIT=0

# ── 后端服务（转发目标；默认取各服务端口配置）─────────
# GATEWAY_BACKEND_HOST=127.0.0.1
# GATEWAY_DIST_DIR=../../frontend/dist
