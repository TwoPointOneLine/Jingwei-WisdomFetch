# 根目录 EditorConfig —— 跨编辑器统一基础风格
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,md}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{ts,tsx,js,jsx}]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf
indent_style = tab

[Makefile]
indent_style = tab
