# ===== 虚拟环境 =====
.venv/
venv/
env/

# ===== 环境变量（含敏感信息，禁止提交；.env.example 模板需保留）=====
.env
.env.*
!.env.example

# ===== 日志（运行期产物）=====
logs/
*.log
*.err

# ===== Python 缓存与构建产物 =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ===== 前端（pnpm build 产物）=====
node_modules/
frontend/node_modules/
frontend/dist/
dist/

# ===== 输出目录（运行期生成，如需保留生成结果可删除本行）=====
output/

# ===== IDE / 助手工具数据 =====
.idea/
.vscode/
.codebuddy/
*.swp
*.swo

# ===== 操作系统 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== uv 本地缓存（uv.lock 需提交，不要忽略）=====
.uv-cache/

# ===== 文档 =====
# 注意：docs/ 为正式产品/需求/架构文档，必须纳入版本库，切勿忽略。
# 仅忽略可能的单文档构建产物目录 doc/（如有）。
doc/
