# 统一换行符与文件属性

# 文本文件统一 LF（Windows  checkout 时自动转 CRLF，提交回 LF）
* text=auto eol=lf

# 明确的文本类型
*.py      text
*.toml    text
*.md      text
*.yml     text
*.yaml    text
*.json    text
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.sh      text eol=lf

# 二进制文件（不 diff）
*.png     binary
*.jpg     binary
*.jpeg    binary
*.svg     text
*.woff    binary
*.woff2   binary
*.ttf     binary
*.otf     binary
