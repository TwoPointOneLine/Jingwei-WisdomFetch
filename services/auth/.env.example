# ── 应用 ─────────────────────────────────────────────
APP_ENV=dev
APP_HOST=0.0.0.0
AUTH_APP_NAME=shopkeeper-auth
AUTH_APP_PORT=8083
CORS_ORIGINS=*

# ── MongoDB（所有服务共享同一 DB，跨服务 token 校验依赖 auth_tokens 集合）───
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=enterprise_rag

# ── 引导管理员（注册时命中则角色为 admin，逗号分隔）───
AUTH_BOOTSTRAP_ADMIN=admin
